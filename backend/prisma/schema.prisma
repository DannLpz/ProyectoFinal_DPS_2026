generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  role         String   @default("buyer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  generatedFurniture Furniture[] @relation("UserGeneratedFurniture")
  listings Listing[] @relation("UserListings")
}

model Furniture {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String
  modelUrl      String
  thumbnailUrl  String
  source        String   @default("default") // "default" o "ai-generated"
  prompt        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  listings Listing[] 
  generatedById String?
  generatedBy   User?    @relation("UserGeneratedFurniture", fields: [generatedById], references: [id])
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  currency    String   @default("USD")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  furnitureId String
  furniture   Furniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User      @relation("UserListings", fields: [sellerId], references: [id])
}
