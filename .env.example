# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
DATABASE_URL=postgresql://looka_user:looka_password@postgres:5432/looka_db?schema=public

# ============================================
# SEGURIDAD Y SERVIDOR
# ============================================
JWT_SECRET=tu_clave_secreta_aqui
PORT=3000

# ============================================
# GEMINI (clasificación de prompts)
# Obtener gratis: https://aistudio.google.com/apikey
# ============================================
GEMINI_API_KEY=tu_gemini_key_aqui

# ============================================
# TRIPO3D (generación de modelos 3D)
# Obtener gratis: https://platform.tripo3d.ai/
# La key empieza con "tsk_"
# ============================================
TRIPO_API_KEY=tu_tripo_key_aqui

# ============================================
# FORGE (opcional, ya no se usa)
# ============================================
FORGE_TIER=draft